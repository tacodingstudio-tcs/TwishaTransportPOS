# =============================================================================
# .env.example — Copy this to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local development (matches docker-compose.yml)
DATABASE_URL=postgresql://billing_app:localdev123@localhost:5434/billing_db

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381

# ── AUTH ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string
# Short-lived access token — refresh tokens (stored server-side, see
# refresh_tokens table) handle long-lived sessions. Do not extend this
# to "fix" session expiry complaints; that's what /auth/refresh is for.
JWT_EXPIRES_IN=15m

# ── AI — Claude API ───────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# ── PAYMENTS — Razorpay ───────────────────────────────────────────────────────
# Use test keys during development (rzp_test_...)
# Get from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_replace_with_key
RAZORPAY_KEY_SECRET=replace_with_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ── WHATSAPP — WABA ───────────────────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps
WHATSAPP_TOKEN=replace_with_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# ── GST API — Masters India ───────────────────────────────────────────────────
# Get from: https://www.mastersindia.co
MASTERS_INDIA_API_KEY=replace_with_key

# ── FILE STORAGE ──────────────────────────────────────────────────────────────
# Local: files stored in /tmp during development
# Production: switch to Azure Blob or Backblaze B2
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/tmp/billing-files

# Azure Blob (fill when deploying to production)
# STORAGE_TYPE=azure
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_STORAGE_CONTAINER=billing-files

# ── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
API_BASE_URL=http://localhost:3100

# Frontend URL (for CORS)
WEB_URL=http://localhost:5174

# ── OPTIONAL: MONITORING ──────────────────────────────────────────────────────
# Sentry (free tier works fine)
# SENTRY_DSN=https://replace@sentry.io/replace
