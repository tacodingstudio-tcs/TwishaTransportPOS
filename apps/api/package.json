{
  "name": "@billing/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "tsx --env-file=.env scripts/seed-demo.ts",
    "provision:all": "tsx --env-file=.env scripts/provision-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@billing/db": "workspace:*",
    "@billing/domain-registry": "workspace:*",
    "@billing/gst-engine": "workspace:*",
    "@billing/pdf": "workspace:*",
    "@billing/shared": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.16.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.0.0",
    "date-fns": "^3.6.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.0",
    "openai": "^6.45.0",
    "puppeteer": "^22.0.0",
    "razorpay": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.0",
    "axios": "^1.7.0",
    "jest": "^29.0.0",
    "pino-pretty": "^11.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
