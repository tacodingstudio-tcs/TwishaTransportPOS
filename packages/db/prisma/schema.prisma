// =============================================================================

// =============================================================================
// SERVICE VISITS — pest control AMC visit tracking
// =============================================================================

// =============================================================================
// NOTIFICATIONS — in-app notifications surfaced to owner/manager
// Types: payment_reminder_draft | low_stock | renewal_due | visit_overdue | generic
// payment_reminder_draft drafts must be approved before WhatsApp send.
// =============================================================================
model Expense {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String    @db.Uuid
  date          DateTime  @default(now()) @db.Date

  category      String              // code from domain registry e.g. 'rent', 'purchases'
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  gstAmount     Decimal   @db.Decimal(12, 2) @default(0)
  gstRate       Int       @default(0)         // 0 / 5 / 12 / 18 / 28

  paymentMode   String    @default("cash")    // cash / upi / bank / credit
  partyId       String?   @db.Uuid            // optional vendor / supplier link
  referenceNo   String?                       // bill no, receipt no from vendor
  notes         String?
  attachmentUrl String?                       // photo of physical bill (S3 / base64)

  isRecurring   Boolean   @default(false)
  recurrence    String?                       // monthly / weekly / yearly

  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([branchId, date(sort: Desc)])
  @@index([branchId, category])
  @@index([branchId, partyId])
  @@map("expenses")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String    @db.Uuid
  type      String                       // payment_reminder_draft | low_stock | renewal_due | ...
  title     String
  body      String
  payload   Json      @default("{}")     // full context (partyId, draftMessage, etc.)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  // For payment_reminder_draft: null=pending, true=approved+queued, false=dismissed
  approved  Boolean?
  approvedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([branchId, isRead])
  @@index([branchId, type])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("notifications")
}

model CashRegisterEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @db.Uuid
  date        DateTime @db.Date
  systemCash  Decimal  @db.Decimal(14, 2)
  countedCash Decimal  @db.Decimal(14, 2)
  // difference is a generated column in DB; not mapped here to avoid Prisma conflicts
  notes       String?
  closedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, date])
  @@index([branchId, date(sort: Desc)])
  @@map("cash_register_entries")
}

model BankAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @db.Uuid
  name           String
  bankName       String?
  accountNumber  String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reconciliations BankReconciliationEntry[]

  @@index([branchId])
  @@map("bank_accounts")
}

model BankReconciliationEntry {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String      @db.Uuid
  bankAccountId     String?     @db.Uuid
  month             String      @db.Char(7)
  statementBalance  Decimal     @db.Decimal(14, 2)
  bookBalance       Decimal     @db.Decimal(14, 2)
  // difference is a generated column in DB
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@unique([branchId, bankAccountId, month])
  @@index([branchId, month(sort: Desc)])
  @@map("bank_reconciliation_entries")
}

model StaffShift {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String   @db.Uuid
  userId     String   @db.Uuid
  date       DateTime @db.Date
  shiftType  String   @default("full_day")
  shiftStart DateTime? @db.Time
  shiftEnd   DateTime? @db.Time
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([branchId, date(sort: Desc)])
  @@index([branchId, userId, date(sort: Desc)])
  @@map("staff_shifts")
}

model StaffAttendance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String    @db.Uuid
  userId      String    @db.Uuid
  date        DateTime  @db.Date
  clockIn     DateTime?
  clockOut    DateTime?
  // hoursWorked is a generated column in DB; not mapped to avoid Prisma conflicts
  status      String    @default("present")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([branchId, userId, date])
  @@index([branchId, date(sort: Desc)])
  @@map("staff_attendance")
}

